# Oracle Database 접속 정보
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password
# EZConnect 형식: host:port/service_name
ORACLE_CONNECT_STRING=127.0.0.1:1521/orcl

# Oracle Instant Client 경로 (Thick 모드 - Oracle 11g 연결 필수)
# 패쇄망 환경에서는 반드시 Thick 모드 사용
# 예: C:\instantclient_21_6  또는  C:\instantclient_19_18
ORACLE_CLIENT_PATH=C:\instantclient_

# 서버 포트
PORT=7300

# 로그인 인증
AUTH_USERNAME=admin
AUTH_PASSWORD=DevPass123!
