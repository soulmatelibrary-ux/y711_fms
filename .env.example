# Y711 FMS Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit .env to git (it contains sensitive credentials)

# ========================================
# Authentication
# ========================================

# Default admin username (used for first login)
DEFAULT_ADMIN_USERNAME=admin

# Default admin password (MUST be changed after first login)
# REQUIREMENTS:
#   - Minimum 8 characters
#   - At least 1 number
#   - At least 1 special character
DEFAULT_ADMIN_PASSWORD=AdminPass123!

# JWT Secret (use strong random string for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Token Expiration (in seconds, default 3600 = 1 hour)
JWT_EXPIRES_IN=3600

# Session Idle Timeout (in minutes, default 30)
SESSION_TIMEOUT_MINUTES=30

# ========================================
# Database (Oracle)
# ========================================

# Oracle Database User
ORACLE_USER=your_oracle_username

# Oracle Database Password
ORACLE_PASSWORD=your_oracle_password

# Oracle Connection String
ORACLE_CONNECT_STRING=localhost:1521/ORCL

# ========================================
# Server Configuration
# ========================================

# Server Port
PORT=3000

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Environment (development, production)
NODE_ENV=development

# ========================================
# Security
# ========================================

# Enable HTTPS (set to true for production)
ENABLE_HTTPS=false

# SSL Certificate Path (if ENABLE_HTTPS=true)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Rate Limit: Requests per minute (global)
RATE_LIMIT_GLOBAL=100

# Rate Limit: Requests per minute (auth/login endpoint)
RATE_LIMIT_LOGIN=5

# ========================================
# Logging
# ========================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log Directory
LOG_DIR=./logs

# ========================================
# Email (for password reset, alerts)
# ========================================

# Email Service (smtp, sendgrid, aws-ses)
EMAIL_SERVICE=smtp

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# From Address
EMAIL_FROM=noreply@y711fms.com

# Admin Email (for alerts)
ADMIN_EMAIL=admin@y711fms.com

# ========================================
# Feature Flags
# ========================================

# Enable 2FA (Two-Factor Authentication)
ENABLE_2FA=false

# Enable Email Verification
ENABLE_EMAIL_VERIFICATION=false

# Enable Audit Logging
ENABLE_AUDIT_LOGGING=true
